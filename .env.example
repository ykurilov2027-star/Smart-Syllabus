# Provider: mock or gemini_compat. The Gemini-compatible provider is a PR15 placeholder.
LLM_PROVIDER=mock
LLM_MODEL=mock-syllabus-v1
# Leave empty for mock. For gemini_compat, set LLM_API_KEY or GEMINI_API_KEY in .env.
LLM_API_KEY=
LLM_TIMEOUT_S=30

# Local paths for SQLite and application logs.
DB_PATH=data/smart_syllabus.sqlite3
LOG_FILE=logs/app.log

# Shown by the health endpoint; never place secrets here.
APP_VERSION=dev

# Mock-only fault injection. Keep disabled for normal use.
MOCK_DELAY_MS=0
MOCK_FAILURE_RATE=0
MOCK_FAILURE_KIND=unavailable
